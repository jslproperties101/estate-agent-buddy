{
  "name": "estate-agent-buddy",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "build": "node scripts/build.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:ui",
    "single": "node scripts/single.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "typescript": "6.0.3"
  }
}
