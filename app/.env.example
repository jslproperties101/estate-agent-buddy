# Copy to app/.env (ignored by Git) or set these as environment variables / GitHub Actions secrets.
# Never commit real keys.

# Google Maps Platform key. Enable: Maps JavaScript API, Geocoding API, Places API (New), Routes API.
# Restrict it by website: https://localhost/* (Android app) and https://jslproperties101.github.io/* (web). See docs/SETUP.md.
# app/.env is ignored by Git: never commit a real key (GitHub Actions uses the repository secret).
EAB_GOOGLE_MAPS_API_KEY=

# Optional cloud copy (Supabase). Run supabase/migrations/*.sql in the project first.
EAB_SUPABASE_URL=
EAB_SUPABASE_ANON_KEY=

# Optional Ask Expert AI answers: URL of the deployed supabase/functions/ask-expert function.
EAB_EXPERT_API_URL=
