# Debug signing key for the Android debug APK (not a secret: standard debug passwords). Committed so every
# debug build has the same signature and installs over the previous one.
!app/android-config/debug.keystore

# Screenshots are regenerated by every screen-test run; only chosen ones are committed (git add -f).
app/tests/screens/*.png
